# Copia este archivo como ".env" y completa los valores reales.
# NUNCA subas el archivo ".env" real a un repositorio público.

# Cuenta de Gmail que ENVÍA el correo (remitente)
EMAIL_USER=tu_correo@gmail.com

# Contraseña de aplicación de Gmail (NO tu contraseña normal).
# Genérala en: https://myaccount.google.com/apppasswords
# (requiere tener activada la verificación en dos pasos)
EMAIL_PASS=tu_contrasena_de_aplicacion

# Correo que RECIBE los mensajes del formulario de contacto
RECIPIENT_EMAIL=mariat018@gmail.com

# Opcional: solo si usas un proveedor SMTP distinto a Gmail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
